#!/usr/bin/env bash
# C3_NO_AGNOS: AGNOS updater disabled on Comma 3 (flag: /data/no_agnos_update)
if [ -f /data/no_agnos_update ]; then
  echo "C3: AGNOS updater disabled (/data/no_agnos_update exists)"
  exit 0
fi


DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"

AGNOS_PY=$1
MANIFEST=$2

if [[ ! -f "$AGNOS_PY" || ! -f "$MANIFEST" ]]; then
  echo "invalid args"
  exit 1
fi

if systemctl is-active --quiet weston-ready; then
  $DIR/updater_weston $AGNOS_PY $MANIFEST
else
  $DIR/updater_magic $AGNOS_PY $MANIFEST
fi
